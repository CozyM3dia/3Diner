# ── Secrets (NEVER commit) ──────────────────────────────
.mcp.json
**/.env
**/.env.*
!**/.env.example
**/.vercel

# ── Dependencies / build ────────────────────────────────
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/

# ── Logs / OS / editor ──────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Misc ────────────────────────────────────────────────
*.tsbuildinfo
**/next-env.d.ts

# Local isolated Git worktrees
.worktrees/

# ── Agent tooling / scratch state ───────────────────────
# .superpowers/brainstorm menyimpan token dev-server dan PID; .commandcode
# menyimpan setelan lokal. Keduanya per-mesin, bukan bagian proyek.
.commandcode/
.superpowers/
App/tmp/
# App/Temp menyimpan probe SQL, skrip ekstraksi, dan catatan terhadap database
# hidup. Repo ini publik: isinya tidak pernah boleh ikut `git add -A`.
App/Temp/

# ── Dokumen produk (repo publik) ────────────────────────
# Panduan produk berisi harga, roadmap, dan keputusan bisnis. Simpan di disk,
# jangan dipublikasikan lewat repo. Hanya root — docs/ tetap bisa di-commit.
/*.docx
