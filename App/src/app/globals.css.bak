@import "tailwindcss";

/* ── 3Diner Brand Tokens ── */
:root {
  --navy:         #022C60;
  --navy-dark:    #002355;
  --navy-soft:    #254473;
  --navy-muted:   #51698F;
  --orange:       #FD5002;
  --orange-bright:#FC6A41;
  --orange-ink:   #C23B00; /* AA-contrast orange for small text on light (≈5.4:1) */
  --orange-blush: #FDE8DC;
  --orange-tint:  #FDD8C3;
  --white:        #FDFDFD;
  --paper:        #F6F8FB;
  --border:       #CFD9E4;
  --surface:      #E0E7EE;
  --radius:       18px;
  --radius-card:  16px;

  /* Layered elevation — navy-tinted, never pure black */
  --shadow-sm: 0 1px 2px rgba(2,44,96,0.06), 0 1px 1px rgba(2,44,96,0.04);
  --shadow-md: 0 4px 14px rgba(2,44,96,0.08), 0 2px 4px rgba(2,44,96,0.05);
  --shadow-lg: 0 18px 44px rgba(2,44,96,0.14), 0 6px 14px rgba(2,44,96,0.08);
  --shadow-orange: 0 6px 20px rgba(253,80,2,0.28);

  /* Motion — Jakub-polish: smooth ease-out, production-subtle */
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-soft: cubic-bezier(0.33, 1, 0.68, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* ── Dashboard dark tokens (brand/UI_TOKENS.md) ── */
  --dash-canvas:    #060E1B;
  --dash-sidebar:   #0B1728;
  --dash-panel:     #0D1829;
  --dash-raised:    #132136;
  --dash-text:      #E9EEF6;
  --dash-muted:     #5A7898;
  --dash-secondary: #9FB6D1;
  --dash-border:    rgba(255,255,255,0.07);
  --dash-border-strong: rgba(255,255,255,0.12);

  --semantic-success: #22D3A6;
  --semantic-teal:    #00C2A8;
  --semantic-warning: #F59E0B;
  --semantic-danger:  #EF4444;

  --radius-xs:   8px;
  --radius-sm:   12px;
  --radius-md:   16px;
  --radius-lg:   20px;
  --radius-pill: 999px;

  --shadow-dashboard: 0 18px 48px rgba(0, 0, 0, 0.22);
}

@theme inline {
  --color-navy:         var(--navy);
  --color-navy-dark:    var(--navy-dark);
  --color-navy-soft:    var(--navy-soft);
  --color-navy-muted:   var(--navy-muted);
  --color-orange:       var(--orange);
  --color-orange-bright:var(--orange-bright);
  --color-orange-ink:   var(--orange-ink);
  --color-orange-blush: var(--orange-blush);
  --color-orange-tint:  var(--orange-tint);
  --color-white:        var(--white);
  --color-paper:        var(--paper);
  --color-border:       var(--border);
  --color-surface:      var(--surface);

  --font-display: var(--font-poppins);
  --font-body:    var(--font-poppins);
}

/* ── Base ── */
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}
html { scroll-behavior: smooth; }
body {
  background-color: var(--paper);
  color: var(--navy);
  font-family: var(--font-poppins), system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  min-height: 100dvh;
}

/* Headings use Poppins heavy — single-font system matching Stitch */
.font-display {
  font-family: var(--font-poppins), system-ui, sans-serif;
  letter-spacing: -0.02em;
}

/* On-brand focus ring (keyboard a11y) */
input:focus-visible, textarea:focus-visible, button:focus-visible, a:focus-visible {
  outline: 2px solid var(--orange);
  outline-offset: 2px;
}

.no-scrollbar { scrollbar-width: none; }
.no-scrollbar::-webkit-scrollbar { display: none; }

/* Hide model-viewer's built-in AR button — we use our own branded CTA */
model-viewer::part(default-ar-button) { display: none !important; }

/* Right-edge fade to hint horizontal scroll (category chips) */
.scroll-fade-r {
  -webkit-mask-image: linear-gradient(to right, #000 88%, transparent 100%);
  mask-image: linear-gradient(to right, #000 88%, transparent 100%);
}

::-webkit-scrollbar       { width: 4px; }
::-webkit-scrollbar-track { background: var(--surface); }
::-webkit-scrollbar-thumb { background: var(--navy-muted); border-radius: 99px; }

/* ── Grain / noise overlay for depth ── */
.grain::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.5;
  mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 240 240' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
}

/* ── Card ── */
.card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-md);
}

/* Menu card — photo top, body below (Stitch style). Tactile press. */
.menu-card {
  transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease;
  will-change: transform;
}
.menu-card:active { transform: scale(0.97); }
@media (hover: hover) {
  .menu-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .menu-card:hover .card-img { transform: scale(1.05); }
}
.menu-card .card-img { transition: transform 0.5s var(--ease-out); }

/* Branded placeholder mesh for dishes without a photo */
.dish-mesh {
  background:
    radial-gradient(120% 90% at 20% 15%, rgba(253,80,2,0.28) 0%, transparent 55%),
    radial-gradient(110% 100% at 90% 90%, rgba(81,105,143,0.45) 0%, transparent 60%),
    linear-gradient(150deg, #022C60 0%, #002355 100%);
}

/* ── Tactile press for buttons / tappables ── */
.press { transition: transform 0.12s var(--ease-soft), box-shadow 0.2s ease; }
.press:active { transform: scale(0.96); }

/* Primary orange CTA — gradient body + travelling sheen on hover */
.btn-primary {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, var(--orange-bright) 0%, var(--orange) 55%, #E64500 100%);
  color: #fff;
  box-shadow: var(--shadow-orange);
}
.btn-primary::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, transparent 30%, rgba(255,255,255,0.35) 50%, transparent 70%);
  transform: translateX(-120%);
  pointer-events: none;
}
@media (hover: hover) {
  .btn-primary:hover::after { transform: translateX(120%); transition: transform 0.7s var(--ease-out); }
  .btn-primary:hover { filter: brightness(1.04); }
}
.btn-primary:active { transform: translateY(1px) scale(0.99); box-shadow: 0 3px 12px rgba(253,80,2,0.24); }

/* Navy hero CTA (3D viewer button) — same sheen, navy body */
.btn-navy {
  position: relative;
  overflow: hidden;
  background: linear-gradient(140deg, #0A3A78 0%, var(--navy) 60%, var(--navy-dark) 100%);
  color: #fff;
  box-shadow: 0 10px 28px rgba(2,44,96,0.30);
}
.btn-navy::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, transparent 30%, rgba(255,255,255,0.25) 50%, transparent 70%);
  transform: translateX(-120%);
  animation: sheenSweep 3.4s var(--ease-out) infinite;
  pointer-events: none;
}
@keyframes sheenSweep {
  0%, 55%  { transform: translateX(-120%); }
  85%, 100% { transform: translateX(120%); }
}

/* Category chip — springy select */
.chip {
  transition: background 0.22s var(--ease-out), color 0.22s var(--ease-out),
              box-shadow 0.22s var(--ease-out), transform 0.16s var(--ease-spring);
}
.chip:active { transform: scale(0.92); }
.chip[aria-pressed="true"] { box-shadow: 0 6px 16px rgba(2,44,96,0.22); }

/* Deals rail card */
.deal-card {
  transition: transform 0.25s var(--ease-out), box-shadow 0.25s ease;
}
.deal-card:active { transform: scale(0.96); }
@media (hover: hover) {
  .deal-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
}

/* Qty number pop when it changes */
@keyframes qtyPop {
  0%   { transform: scale(1); }
  45%  { transform: scale(1.35); }
  100% { transform: scale(1); }
}
.qty-pop { animation: qtyPop 0.28s var(--ease-spring); }

/* iOS-style mini switch (3D-only filter) */
.switch-track {
  transition: background 0.2s var(--ease-out);
}
.switch-knob {
  transition: transform 0.22s var(--ease-spring);
}

/* Search bar focus lift */
.search-field {
  border: 1.5px solid transparent;
  box-shadow: var(--shadow-sm);
  transition: border-color 0.2s var(--ease-out), box-shadow 0.25s var(--ease-out);
}
.search-field:focus-within {
  border-color: rgba(253,80,2,0.55);
  box-shadow: 0 0 0 4px rgba(253,80,2,0.10), var(--shadow-md);
}

/* ── 3D badge pill ── */
.badge-3d {
  background: var(--orange-blush);
  color: var(--orange-ink);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: 99px;
  padding: 4px 8px;
}

/* ── Shimmer skeleton ── */
@keyframes shimmer {
  0%   { background-position: -400px 0; }
  100% { background-position:  400px 0; }
}
.skeleton {
  background: linear-gradient(90deg, var(--surface) 25%, var(--border) 50%, var(--surface) 75%);
  background-size: 800px 100%;
  animation: shimmer 1.6s infinite linear;
  border-radius: 12px;
}

/* ── Entrance ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-up { animation: fadeUp 0.5s var(--ease-out) forwards; }

@keyframes floatY {
  0%,100% { transform: translateY(0); }
  50%     { transform: translateY(-7px); }
}
.float { animation: floatY 4.5s ease-in-out infinite; }

/* Pulsing ring for active timeline / status */
@keyframes pulseRing {
  0%   { box-shadow: 0 0 0 0 rgba(253,80,2,0.45); }
  70%  { box-shadow: 0 0 0 8px rgba(253,80,2,0); }
  100% { box-shadow: 0 0 0 0 rgba(253,80,2,0); }
}
.pulse-ring { animation: pulseRing 2s var(--ease-soft) infinite; }

/* Soft pulsing dot (waiting states) */
@keyframes pulseDot {
  0%,100% { opacity: 0.4; transform: scale(0.85); }
  50%     { opacity: 1; transform: scale(1); }
}
.pulse-dot { animation: pulseDot 1.4s ease-in-out infinite; }

/* Cart FAB pop-in */
@keyframes fabIn {
  from { opacity: 0; transform: translateY(12px) scale(0.9); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.fab-in { animation: fabIn 0.34s var(--ease-out) forwards; }

.stagger-1 { animation-delay: 0.04s; opacity: 0; }
.stagger-2 { animation-delay: 0.09s; opacity: 0; }
.stagger-3 { animation-delay: 0.14s; opacity: 0; }
.stagger-4 { animation-delay: 0.19s; opacity: 0; }
.stagger-5 { animation-delay: 0.24s; opacity: 0; }
.stagger-6 { animation-delay: 0.29s; opacity: 0; }

/* ── Dashboard font: Poppins (brand contract — UI_TOKENS.md) ── */
.dash-root, .dash-root .font-display {
  font-family: var(--font-poppins), system-ui, sans-serif;
}

/* Dark canvas covers full document + overscroll while dashboard is mounted */
html:has(.dash-root), body:has(.dash-root) {
  background: var(--dash-canvas);
}

/* ── Dash-8 panel language: card with separated header band ── */
.dash-panel {
  background: var(--dash-panel);
  border: 1px solid var(--dash-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.dash-panel-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  background: rgba(255,255,255,0.025);
  border-bottom: 1px solid var(--dash-border);
  color: var(--dash-muted);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.dash-panel-body { padding: 16px; }

/* Delta chip (dash-8 KPI style) */
.delta-chip {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  font-size: 11px;
  font-weight: 700;
  border-radius: var(--radius-pill);
  padding: 2px 7px;
  font-variant-numeric: tabular-nums;
}
.delta-chip.up   { color: var(--semantic-success); background: rgba(34,211,166,0.10); }
.delta-chip.down { color: var(--semantic-danger);  background: rgba(239,68,68,0.10); }

/* ── Dashboard (dark) interaction layer ── */
.dash-card {
  transition: border-color 0.18s var(--ease-out), transform 0.18s var(--ease-out);
}
@media (hover: hover) {
  .dash-card:hover { border-color: rgba(255,255,255,0.16); transform: translateY(-2px); }
}
.dash-press { transition: transform 0.12s var(--ease-soft), background 0.15s var(--ease-out), filter 0.15s var(--ease-out), opacity 0.15s; }
.dash-press:active { transform: scale(0.96); }
.dash-row { transition: background 0.15s var(--ease-out); }
@media (hover: hover) { .dash-row:hover { background: rgba(255,255,255,0.035); } }
.dash-nav { transition: background 0.15s var(--ease-out), color 0.15s var(--ease-out); }
@media (hover: hover) { .dash-nav:not(.is-active):hover { background: rgba(255,255,255,0.05); color: #E9EEF6 !important; } }

/* Nav pending: soft pulse on icon while route transition is in flight */
@keyframes navPulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.45; }
}
.dash-nav.is-pending svg { animation: navPulse 0.9s ease-in-out infinite; }
.dash-input { transition: border-color 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out); }
.dash-input:focus { border-color: rgba(253,80,2,0.6) !important; box-shadow: 0 0 0 3px rgba(253,80,2,0.13); outline: none; }
.dash-btn { transition: filter 0.15s var(--ease-out), transform 0.12s var(--ease-soft), box-shadow 0.18s var(--ease-out); }
@media (hover: hover) { .dash-btn:hover { filter: brightness(1.08); } }
.dash-btn:active { transform: scale(0.97); }
.dash-icon-btn { transition: background 0.15s var(--ease-out), color 0.15s var(--ease-out); }
@media (hover: hover) { .dash-icon-btn:hover { background: rgba(255,255,255,0.06); color: #E9EEF6; } }
.dash-chip { transition: background 0.15s var(--ease-out), color 0.15s var(--ease-out), border-color 0.15s var(--ease-out), transform 0.12s var(--ease-soft); }
.dash-chip:active { transform: scale(0.95); }

/* Dashboard dark skeleton shimmer */
@keyframes dashShimmer {
  0%   { background-position: -360px 0; }
  100% { background-position:  360px 0; }
}
.dash-skel {
  background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.04) 75%);
  background-size: 720px 100%;
  animation: dashShimmer 1.5s infinite linear;
}

/* Dashboard section reveal (JS-free, runs on mount) */
@keyframes dashReveal {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}
.dash-reveal { animation: dashReveal 0.28s var(--ease-out) both; }
.dash-d1 { animation-delay: 0.03s; }
.dash-d2 { animation-delay: 0.06s; }
.dash-d3 { animation-delay: 0.09s; }
.dash-d4 { animation-delay: 0.12s; }
.dash-d5 { animation-delay: 0.15s; }

/* ── Accessibility: respect reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .fade-up, .float, .pulse-ring, .pulse-dot, .fab-in, .dash-reveal, .qty-pop { animation: none !important; opacity: 1 !important; transform: none !important; }
  .btn-navy::after, .btn-primary::after { animation: none !important; transform: translateX(-120%) !important; }
  .menu-card, .menu-card .card-img { transition: none !important; }
}
