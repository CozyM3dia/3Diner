# Midtrans (server-side — never exposed to the browser)
MIDTRANS_SERVER_KEY=
# "true" to hit Midtrans production, otherwise sandbox
MIDTRANS_IS_PRODUCTION=false

# Midtrans client key (public — used by Snap.js in the browser)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Datadog monitoring (optional)
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=

# Datadog server-side (optional)
DD_API_KEY=

# Clerk authentication (server-side secret must never be exposed to the browser)
CLERK_SECRET_KEY=
# Clerk publishable key (safe for browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional: only needed when adding Clerk -> Supabase webhook synchronization
# CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk telemetry posts to clerk-telemetry.com, an origin the app CSP does not allow.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
CLERK_TELEMETRY_DISABLED=1

# Akun demo untuk akses cepat di halaman /login (opsional).
# Keduanya PUBLIK — panel demo menampilkannya di layar; isi hanya dengan akun
# demo terpisah yang datanya boleh diubah siapa pun yang punya tautannya.
# Kosongkan keduanya untuk menyembunyikan panel demo sepenuhnya.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
# Slug kafe yang katalognya disalin ke akun demo (`npm run demo:seed`).
# Kosong = kafe non-demo dengan model 3D terbanyak. Jangan menautkan user demo ke kafe ini.
DEMO_SOURCE_SLUG=

